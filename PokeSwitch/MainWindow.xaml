<ui:FluentWindow x:Class="PokeSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="PokeSwitch"
        Height="690"
        Width="900"
        MinHeight="620"
        MinWidth="820"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{x:Null}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="PokeSwitch" Grid.Row="0" Margin="0,0,0,6">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/PokeSwitch.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:Flyout Placement="Bottom" IsOpen="{Binding IsSettingsOpen, Mode=TwoWay}">
            <ScrollViewer MaxHeight="590" VerticalScrollBarVisibility="Auto">
                <StackPanel Width="350" Margin="10">
                    <TextBlock Text="Settings" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <TextBlock Text="WSL Distro Name:" Margin="0,4,0,0"/>
                    <ui:TextBox Text="{Binding Config.WslDistroName, Mode=TwoWay}" Margin="0,4,0,8"/>

                    <TextBlock Text="Docker Desktop Path:"/>
                    <ui:TextBox Text="{Binding Config.DockerDesktopPath, Mode=TwoWay}" Margin="0,4,0,8"/>

                    <CheckBox Content="Enable Logging" IsChecked="{Binding Config.Logging.Enabled, Mode=TwoWay}" Margin="0,0,0,4"/>
                    <CheckBox Content="Write Rolling Log File" IsChecked="{Binding Config.Logging.FileEnabled, Mode=TwoWay}" Margin="0,0,0,4"/>
                    <CheckBox Content="Auto-start WSL on Launch" IsChecked="{Binding Config.AutoStartWslOnLaunch, Mode=TwoWay}" Margin="0,0,0,4"/>
                    <CheckBox Content="Auto-start Docker on Launch" IsChecked="{Binding Config.AutoStartDockerOnLaunch, Mode=TwoWay}" Margin="0,0,0,12"/>

                    <TextBlock Text="GPU Name Pattern:"/>
                    <ui:TextBox Text="{Binding Config.Hardware.GpuDeviceNamePattern, Mode=TwoWay}" Margin="0,4,0,8"/>

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Selected GPU:" VerticalAlignment="Center"/>
                        <ui:Button Content="Refresh" Appearance="Secondary" Command="{Binding RefreshGpuDevicesCommand}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ComboBox ItemsSource="{Binding DisplayDevices}"
                              DisplayMemberPath="FriendlyName"
                              SelectedValuePath="InstanceId"
                              SelectedValue="{Binding Config.Hardware.GpuInstanceId, Mode=TwoWay}"
                              Margin="0,0,0,8"/>

                    <CheckBox Content="Confirm GPU Disable" IsChecked="{Binding Config.Toggles.ConfirmGpuDisable, Mode=TwoWay}" Margin="0,0,0,4"/>
                    <CheckBox Content="Confirm Docker Stop" IsChecked="{Binding Config.Toggles.ConfirmDockerStop, Mode=TwoWay}" Margin="0,0,0,4"/>
                    <CheckBox Content="Confirm Nuclear Shutdown" IsChecked="{Binding Config.Toggles.ConfirmNuclearShutdown, Mode=TwoWay}" Margin="0,0,0,12"/>

                    <CheckBox Content="Enable Tray Menu" IsChecked="{Binding Config.Tray.Enabled, Mode=TwoWay}" Margin="0,0,0,4"/>
                    <CheckBox Content="Minimize to Tray" IsChecked="{Binding Config.Tray.MinimizeToTray, Mode=TwoWay}" Margin="0,0,0,12"/>

                    <TextBlock Text="Polling Interval (Seconds):" Margin="0,0,0,4"/>
                    <Slider Minimum="1" Maximum="10" Value="{Binding Config.Dashboard.PollIntervalSeconds, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Config.Dashboard.PollIntervalSeconds, StringFormat='{}Current: {0}s'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,-4,0,12"/>

                    <ui:Button Content="Save &amp; Apply" Appearance="Primary" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Right"/>
                </StackPanel>
            </ScrollViewer>
        </ui:Flyout>

        <Grid Grid.Row="1" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52*"/>
                <ColumnDefinition Width="48*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Dashboard" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Settings24}" Command="{Binding OpenSettingsCommand}" ToolTip="Settings" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ui:Card Grid.Row="0" Grid.Column="0" Margin="0,0,4,4" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Docker" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <ui:SymbolIcon Symbol="Server24" Foreground="{Binding DockerStatusColor, FallbackValue=Gray}" FontSize="18" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding DockerStatusText, FallbackValue='Checking...'}" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Grid.Row="0" Grid.Column="1" Margin="4,0,0,4" Padding="10">
                            <StackPanel>
                                <TextBlock Text="WSL" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <ui:SymbolIcon Symbol="Box24" Foreground="{Binding WslStatusColor, FallbackValue=Gray}" FontSize="18" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding WslStatusText, FallbackValue='Checking...'}" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Grid.Row="1" Grid.Column="0" Margin="0,4,4,0" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Containers" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <ui:SymbolIcon Symbol="AppsList24" Foreground="#FFB900" FontSize="18" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding ContainerText, FallbackValue='0 / 0'}" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Grid.Row="1" Grid.Column="1" Margin="4,4,0,0" Padding="10">
                            <StackPanel>
                                <TextBlock Text="VMMem" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <ui:SymbolIcon Symbol="DeveloperBoard24" Foreground="#8764B8" FontSize="18" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding RamUsageText, FallbackValue='0 MB'}" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>
                    </Grid>

                    <TextBlock Text="Control Panel" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <ui:CardAction Command="{Binding ToggleWslCommand}" Margin="0,0,0,8" Padding="12" IsEnabled="{Binding WslToggle.IsEnabled}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="{Binding WslToggle.Icon}" Grid.Column="0" FontSize="28" Foreground="{Binding WslToggle.Accent}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding WslToggle.Label}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding WslToggle.Subtitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding WslToggle.LastResult}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>

                    <ui:CardAction Command="{Binding ToggleDockerCommand}" Margin="0,0,0,8" Padding="12" IsEnabled="{Binding DockerToggle.IsEnabled}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="{Binding DockerToggle.Icon}" Grid.Column="0" FontSize="28" Foreground="{Binding DockerToggle.Accent}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DockerToggle.Label}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DockerToggle.Subtitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding DockerToggle.LastResult}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>

                    <ui:CardAction Command="{Binding ToggleGpuCommand}" Margin="0,0,0,8" Padding="12" IsEnabled="{Binding GpuToggle.IsEnabled}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="{Binding GpuToggle.Icon}" Grid.Column="0" FontSize="28" Foreground="{Binding GpuToggle.Accent}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GpuToggle.Label}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding GpuToggle.Subtitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding GpuToggle.LastResult}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>

                    <ui:CardAction Command="{Binding NuclearShutdownCommand}" Margin="0,0,0,8" Padding="12" IsEnabled="{Binding NuclearToggle.IsEnabled}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="{Binding NuclearToggle.Icon}" Grid.Column="0" FontSize="28" Foreground="{Binding NuclearToggle.Accent}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NuclearToggle.Label}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding NuclearToggle.Subtitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding NuclearToggle.LastResult}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>

                    <ui:InfoBar IsOpen="{Binding IsInfoOpen, Mode=TwoWay}"
                                Title="{Binding InfoTitle}"
                                Message="{Binding InfoMessage}"
                                Severity="{Binding InfoSeverity}"
                                Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Live Terminal" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Clipboard24}" Command="{Binding CopyDiagnosticsCommand}" ToolTip="Copy Diagnostics" Margin="0,0,3,0"/>
                        <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Save24}" Command="{Binding ExportLogCommand}" ToolTip="Export Log" Margin="0,0,3,0"/>
                        <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Delete24}" Command="{Binding ClearTerminalCommand}" ToolTip="Clear Log"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="7" Padding="9">
                    <ScrollViewer x:Name="TerminalScrollViewer" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding TerminalText}" Foreground="#CCCCCC" FontFamily="Consolas" TextWrapping="Wrap" FontSize="11"/>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <ui:Button Appearance="Transparent"
                               Command="{Binding ToggleDiagnosticsCommand}"
                               HorizontalAlignment="Left"
                               Padding="6,3"
                               ToolTip="Show or hide diagnostics">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ChevronDown24" FontSize="15" Margin="0,0,5,0"/>
                            <TextBlock Text="Diagnostics" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ui:Button>

                    <Border Background="#202020" CornerRadius="7" Padding="9" ClipToBounds="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="MaxHeight" Value="0"/>
                                <Setter Property="Opacity" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDiagnosticsExpanded}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="170" Duration="0:0:0.18"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="0" Duration="0:0:0.14"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.10"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding DiagnosticsText}" Foreground="#CCCCCC" FontFamily="Consolas" TextWrapping="Wrap" FontSize="10.5"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>

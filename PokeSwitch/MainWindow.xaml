<ui:FluentWindow x:Class="PokeSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="PokeSwitch" Height="760" Width="980"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{x:Null}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar Title="PokeSwitch" Grid.Row="0" Margin="0,0,0,10">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/PokeSwitch.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Settings Flyout -->
        <ui:Flyout x:Name="SettingsFlyout" Placement="Bottom" IsOpen="False">
            <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="360" Margin="10">
                <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                
                <TextBlock Text="WSL Distro Name:" Margin="0,5,0,0"/>
                <ui:TextBox x:Name="TxtWslDistro" Text="{Binding Config.WslDistroName, Mode=TwoWay}" Margin="0,5,0,10"/>
                
                <TextBlock Text="Docker Desktop Path:" Margin="0,0,0,0"/>
                <ui:TextBox x:Name="TxtDockerPath" Text="{Binding Config.DockerDesktopPath, Mode=TwoWay}" Margin="0,5,0,10"/>
                
                <CheckBox Content="Enable Logging" IsChecked="{Binding Config.Logging.Enabled, Mode=TwoWay}" Margin="0,0,0,5"/>
                <CheckBox Content="Write Rolling Log File" IsChecked="{Binding Config.Logging.FileEnabled, Mode=TwoWay}" Margin="0,0,0,5"/>
                <CheckBox Content="Auto-start WSL on Launch" IsChecked="{Binding Config.AutoStartWslOnLaunch, Mode=TwoWay}" Margin="0,0,0,5"/>
                <CheckBox Content="Auto-start Docker on Launch" IsChecked="{Binding Config.AutoStartDockerOnLaunch, Mode=TwoWay}" Margin="0,0,0,15"/>

                <TextBlock Text="GPU Name Pattern:" Margin="0,0,0,0"/>
                <ui:TextBox Text="{Binding Config.Hardware.GpuDeviceNamePattern, Mode=TwoWay}" Margin="0,5,0,10"/>

                <Grid Margin="0,0,0,5">
                    <TextBlock Text="Selected GPU:" VerticalAlignment="Center"/>
                    <ui:Button Content="Refresh" Appearance="Secondary" Click="RefreshGpuDevices_Click" HorizontalAlignment="Right"/>
                </Grid>
                <ComboBox ItemsSource="{Binding DisplayDevices}"
                          DisplayMemberPath="FriendlyName"
                          SelectedValuePath="InstanceId"
                          SelectedValue="{Binding Config.Hardware.GpuInstanceId, Mode=TwoWay}"
                          Margin="0,0,0,10"/>

                <CheckBox Content="Confirm GPU Disable" IsChecked="{Binding Config.Toggles.ConfirmGpuDisable, Mode=TwoWay}" Margin="0,0,0,5"/>
                <CheckBox Content="Confirm Docker Stop" IsChecked="{Binding Config.Toggles.ConfirmDockerStop, Mode=TwoWay}" Margin="0,0,0,5"/>
                <CheckBox Content="Confirm Nuclear Shutdown" IsChecked="{Binding Config.Toggles.ConfirmNuclearShutdown, Mode=TwoWay}" Margin="0,0,0,15"/>

                <CheckBox Content="Enable Tray Menu" IsChecked="{Binding Config.Tray.Enabled, Mode=TwoWay}" Margin="0,0,0,5"/>
                <CheckBox Content="Minimize to Tray" IsChecked="{Binding Config.Tray.MinimizeToTray, Mode=TwoWay}" Margin="0,0,0,15"/>
                
                <TextBlock Text="Polling Interval (Seconds):" Margin="0,0,0,5"/>
                <Slider Minimum="1" Maximum="10" Value="{Binding Config.Dashboard.PollIntervalSeconds, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding Config.Dashboard.PollIntervalSeconds, StringFormat='{}Current: {0}s'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,-5,0,15"/>

                <ui:Button Content="Save &amp; Apply" Appearance="Primary" Click="SaveSettings_Click" HorizontalAlignment="Right"/>
            </StackPanel>
            </ScrollViewer>
        </ui:Flyout>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="55*"/>
                <ColumnDefinition Width="45*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Dashboard & Controls -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,20,0">
                <StackPanel>
                    <!-- Dashboard Section (4 Tiles) -->
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="Dashboard" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Settings24}" Click="OpenSettings_Click" ToolTip="Settings" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,0,0,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tile 1: Docker -->
                        <ui:Card Grid.Row="0" Grid.Column="0" Margin="0,0,5,5" Padding="15">
                            <StackPanel>
                                <TextBlock Text="Docker Status" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <ui:SymbolIcon Symbol="Server24" Foreground="{Binding DockerStatusColor, FallbackValue=Gray}" FontSize="20" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding DockerStatusText, FallbackValue='Checking...'}" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                        <!-- Tile 2: WSL -->
                        <ui:Card Grid.Row="0" Grid.Column="1" Margin="5,0,0,5" Padding="15">
                            <StackPanel>
                                <TextBlock Text="WSL Engine" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <ui:SymbolIcon Symbol="Box24" Foreground="{Binding WslStatusColor, FallbackValue=Gray}" FontSize="20" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding WslStatusText, FallbackValue='Checking...'}" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                        <!-- Tile 3: Containers -->
                        <ui:Card Grid.Row="1" Grid.Column="0" Margin="0,5,5,0" Padding="15">
                            <StackPanel>
                                <TextBlock Text="Running Containers" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <ui:SymbolIcon Symbol="AppsList24" Foreground="#FFB900" FontSize="20" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding ContainerText, FallbackValue='0 / 0'}" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                        <!-- Tile 4: VMMem -->
                        <ui:Card Grid.Row="1" Grid.Column="1" Margin="5,5,0,0" Padding="15">
                            <StackPanel>
                                <TextBlock Text="VMMem RAM Usage" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <ui:SymbolIcon Symbol="DeveloperBoard24" Foreground="#8764B8" FontSize="20" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding RamUsageText, FallbackValue='0 MB'}" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>
                    </Grid>

                    <!-- Actions Section -->
                    <TextBlock Text="Control Panel" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    
                    <ui:CardAction Click="WslToggle_Click" Margin="0,0,0,10" Padding="15" IsEnabled="{Binding WslToggle.IsEnabled}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="{Binding WslToggle.Icon}" Grid.Column="0" FontSize="32" Foreground="{Binding WslToggle.Accent}" Margin="0,0,15,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding WslToggle.Label}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding WslToggle.Subtitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding WslToggle.LastResult}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>

                    <ui:CardAction Click="DockerToggle_Click" Margin="0,0,0,10" Padding="15" IsEnabled="{Binding DockerToggle.IsEnabled}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="{Binding DockerToggle.Icon}" Grid.Column="0" FontSize="32" Foreground="{Binding DockerToggle.Accent}" Margin="0,0,15,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DockerToggle.Label}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DockerToggle.Subtitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding DockerToggle.LastResult}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>

                    <ui:CardAction Click="GpuToggle_Click" Margin="0,0,0,10" Padding="15" IsEnabled="{Binding GpuToggle.IsEnabled}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="{Binding GpuToggle.Icon}" Grid.Column="0" FontSize="32" Foreground="{Binding GpuToggle.Accent}" Margin="0,0,15,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GpuToggle.Label}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding GpuToggle.Subtitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding GpuToggle.LastResult}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>

                    <ui:CardAction Click="NuclearShutdown_Click" Margin="0,0,0,10" Padding="15" IsEnabled="{Binding NuclearToggle.IsEnabled}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="{Binding NuclearToggle.Icon}" Grid.Column="0" FontSize="32" Foreground="{Binding NuclearToggle.Accent}" Margin="0,0,15,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NuclearToggle.Label}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding NuclearToggle.Subtitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding NuclearToggle.LastResult}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>

                    <!-- Status Feedback -->
                    <ui:InfoBar x:Name="StatusInfoBar" IsOpen="False" Title="Status" Message="Ready" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Right Column: Live Terminal -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Live Terminal" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Clipboard24}" Click="CopyDiagnostics_Click" ToolTip="Copy Diagnostics" Margin="0,0,4,0"/>
                        <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Save24}" Click="ExportLog_Click" ToolTip="Export Log" Margin="0,0,4,0"/>
                        <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Delete24}" Click="ClearTerminal_Click" ToolTip="Clear Log"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="8" Padding="10">
                    <ScrollViewer x:Name="TerminalScrollViewer" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtTerminal" Foreground="#CCCCCC" FontFamily="Consolas" TextWrapping="Wrap" FontSize="12"/>
                    </ScrollViewer>
                </Border>

                <Border Grid.Row="2" Background="#202020" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Diagnostics" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding DiagnosticsText}" Foreground="#CCCCCC" FontFamily="Consolas" TextWrapping="Wrap" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
